{
  "manifest_version": 3,
  "name": "New Tab - Shortcuts, Wallpaper & Tab Groups",
  "version": "11.1",
  "description": "Shortcuts, wallpaper customization and a Tab Group Manager on the New Tab page",
  "permissions": ["storage", "topSites", "history", "favicon", "tabs", "tabGroups", "contextMenus", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.alphacoders.com/*",
    "https://*.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://pbs.twimg.com/*"
  ],
  "background": { "service_worker": "background.js" },
 
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "icon.png" }
  },
  "icons": { "128": "icon.png" },
  "web_accessible_resources": [{
    "resources": ["fonts/*.woff2"],
    "matches": ["chrome-extension://*/*"]
  }]
}
